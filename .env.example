# ── Primary provider: Groq (fastest, free, best tool calling) ─────────────────
# Get key at https://console.groq.com/keys
# When set, Groq is used first; OpenRouter is the automatic fallback on 429/error.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Fallback provider: OpenRouter ─────────────────────────────────────────────
# Get key at https://openrouter.ai/  (free models available)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# App settings
APP_SECRET=change_me_in_production
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./wakeel.db
